.env
__pycache__/
*.pyc
third_party/
third_party-src-probe/
results/processed/*
plots/generated/*

# Per-trial CSV files. Each block carries them as one trial-outputs.tar.gz,
# which Git does track. The readers unpack a block on first use, so a clone stays
# small and every check still runs in full. See scripts/trial_bundles.py.
results/*/raw/redis/*/trial-*.csv
results/raw/redis/*/trial-*.csv

# Result archives. They hold the per-trial files and travel with the submitted
# artifact rather than in Git. See archives/README.md.
archives/*.tar.gz
archives/*.tar.gz.sha256
archives/SHA256SUMS.txt
temeraire-*.tar.gz
temeraire-*.tar.gz.sha256
downloaded-results/

# LaTeX build files. Keep these patterns inside notes/ only. Redis writes
# redis-server.log files into the result directories.
notes/*.aux
notes/*.bbl
notes/*.blg
notes/*.log
notes/*.out
notes/*.synctex.gz
notes/*.fdb_latexmk
notes/*.fls

# Local build and scratch directories
output/
tmp/

!.gitkeep

# Git Bash crash dumps
*.stackdump
