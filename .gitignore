.env
__pycache__/
*.pyc
third_party/
third_party-src-probe/
results/processed/*
plots/generated/*

# Per-trial raw CSV files. Git keeps the manifests, summaries, logs, and
# memory samples for every block, which is what the audit and the site build
# read. The per-trial files are too many for Git; get them from the result
# archives.
results/node85-*/raw/redis/*/trial-*.csv
results/raw/redis/*/trial-*.csv

# Result archives. They hold the per-trial files and travel with the submitted
# artifact rather than in Git. See archives/README.md.
archives/*.tar.gz
archives/*.tar.gz.sha256
archives/SHA256SUMS.txt
temeraire-*.tar.gz
temeraire-*.tar.gz.sha256
downloaded-results/

# LaTeX build files. Keep these patterns inside notes/ only. Redis writes
# redis-server.log files into the result directories.
notes/*.aux
notes/*.bbl
notes/*.blg
notes/*.log
notes/*.out
notes/*.synctex.gz
notes/*.fdb_latexmk
notes/*.fls

# Local build and scratch directories
output/
tmp/

!.gitkeep

# Git Bash crash dumps
*.stackdump
